# =============================================================================
# EPIGNOSE — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores:
#     cp .env.example .env
#
# Na Hostinger: hPanel > seu site/VPS > Node.js > Environment Variables,
# ou, se você usa PM2 na VPS, declare em `env: {}` no ecosystem.config.js.
# O `.env` NUNCA deve ser versionado (já está no .gitignore).
#
# A aplicação sobe SEM nenhuma destas chaves, em "modo demonstração" com dados
# de exemplo. Cada bloco abaixo liga uma parte real do sistema.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL) — obrigatório para persistir dados
# -----------------------------------------------------------------------------
# Opções: PostgreSQL na própria VPS da Hostinger, Supabase, Neon ou Railway.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/epignose?schema=public"

# Só para provedores com connection pooling (Supabase/Neon): conexão direta
# usada pelas migrations. Se não for o caso, deixe em branco.
# DIRECT_URL="postgresql://usuario:senha@localhost:5432/epignose"

# -----------------------------------------------------------------------------
# 2. OPENAI — resumos e análise de adequação das referências
# -----------------------------------------------------------------------------
# Crie a chave em https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"
# gpt-4o = melhor qualidade | gpt-4o-mini = ~15x mais barato
OPENAI_MODEL="gpt-4o"

# -----------------------------------------------------------------------------
# 3. BUSCA NA WEB — use Tavily OU Google Custom Search
# -----------------------------------------------------------------------------
# Tavily (recomendado — feito para agentes, devolve o texto da página pronto)
# https://app.tavily.com
TAVILY_API_KEY="tvly-xxxxxxxxxxxxxxxxxxxxxxxx"

# Alternativa: Google Programmable Search Engine
# https://programmablesearchengine.google.com
# GOOGLE_SEARCH_API_KEY="AIzaSy..."
# GOOGLE_SEARCH_ENGINE_ID="a1b2c3d4e5f6g7h8i"

# -----------------------------------------------------------------------------
# 4. STORAGE DOS ARQUIVOS (PDF/DOCX) — Supabase Storage OU AWS S3
# -----------------------------------------------------------------------------
# Supabase: crie o projeto, vá em Storage > New bucket ("artigos", público),
# depois Settings > API para copiar as chaves.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# ATENÇÃO: a service_role ignora RLS. Ela só pode existir no servidor —
# jamais use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="artigos"

# Alternativa: AWS S3 (ver instruções no fim de src/lib/storage.ts)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_S3_BUCKET="epignose-artigos"

# -----------------------------------------------------------------------------
# 5. APLICAÇÃO
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://seudominio.com.br"
# Segredo de sessão — gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
